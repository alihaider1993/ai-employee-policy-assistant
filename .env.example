APP_NAME=AI Employee Policy Assistant
APP_VERSION=0.1.0
ENVIRONMENT=development

# Local Postgres from docker compose. Use postgresql+psycopg:// for any host.
DATABASE_URL=postgresql+psycopg://app_user:local_dev_password@localhost:5433/employee_policy

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

AZURE_OPENAI_EMBEDDING_ENDPOINT=
AZURE_OPENAI_EMBEDDING_KEY=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=

# Optional caps on questions (defaults shown).
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_DAY=200

# Answer cache version. Raise it after any prompt, model or index change.
CACHE_VERSION=1

# Proxies in front of the app that append to X-Forwarded-For (0 = none).
TRUSTED_PROXY_HOPS=1
